# Copy to `.env` (local) or set these as variables on your host. Never commit real values.

# ---------------------------------------------------------------- required
# Postgres with the pgvector extension (Neon, or the Docker database below).
# Hosted databases need ?sslmode=require. For migrations use the DIRECT (not pooled) URL.
DATABASE_URL=postgres://reply:change-me@127.0.0.1:5433/reply
# Everything except /login and /api/health is behind this passcode.
# Use 16+ random characters:  openssl rand -base64 24
APP_PASSCODE=
# Signs the login cookie, 32+ random characters:  openssl rand -base64 48
APP_SESSION_SECRET=
# Anthropic key. A dedicated key lets you set a separate spend limit.
REPLY_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- local database (docker compose)
REPLY_DB_PASSWORD=change-me

# ---------------------------------------------------------------- optional
# Embeddings for memory and notes search. Without it both are switched off.
VOYAGE_API_KEY=
# REPLY_EMBED_MODEL=voyage-3.5-lite
# Per-minute limits of your embedding account. The defaults are the free tier
# (no payment method). Raise them if your account has more, e.g. 2000 and 1000000.
# REPLY_EMBED_RPM=3
# REPLY_EMBED_TPM=10000

# Models (defaults shown)
# REPLY_MODEL_FAST=claude-haiku-4-5
# REPLY_MODEL_SMART=claude-sonnet-5-5
# REPLY_MODEL_SUMMARY=claude-haiku-4-5
# REPLY_MODEL_STYLE=claude-sonnet-5-5
# REPLY_MODEL_EXPLAIN=claude-haiku-4-5
# REPLY_MODEL_NOTES=claude-haiku-4-5
# REPLY_SMART_EFFORT=low
# REPLY_SMART_THINKING=adaptive

# The name(s) you appear under in pasted chats, comma separated, so your own
# lines are marked as yours.
# REPLY_SELF_NAMES=Sam,Samuel
# Requests are refused once a UTC day's spending reaches this many dollars.
# REPLY_DAILY_BUDGET_USD=2
